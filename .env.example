# MySQL：Docker 内主机固定为 mysql；MYSQL_HOST_PORT 只控制宿主机映射端口。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=lessondeck
MYSQL_USER=lessondeck
MYSQL_PASSWORD=change_me
DEEPSEEK_API_KEY=
# true 会强制走确定性规则 fallback，适合离线演示但不代表真实模型生成成功。
AI_FORCE_FALLBACK=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_JSON_REPAIR_ATTEMPTS=1
AI_PROMPT_VERSION=member4-v1
AI_CHUNK_SIZE=500
AI_CHUNK_OVERLAP=60
AI_TOP_K=8
AI_MIN_SCORE=0.08
EMBEDDING_PROVIDER=hash
# 修改 provider/model/dimensions 后必须重建现有 Chroma 向量，不能混用。
EMBEDDING_MODEL=hash-zh-v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=384
CHROMA_PERSIST_DIR=/app/data/chroma
# 以下路径位于 Docker app_data 卷，迁移知识库时需要一起打包。
UPLOAD_DIR=/app/data/uploads
EXPORT_DIR=/app/data/exports
VITE_API_BASE_URL=http://localhost:8000
